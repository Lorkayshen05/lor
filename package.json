{
  "name": "lor-market-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Provider-agnostic market data backend exposing the internal /api/v1 contracts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsup src/server.ts --format esm --out-dir dist --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "pg-mem": "^3.0.14",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
