{
  "name": "ruby-dessert-house",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:mobile": "node scripts/check-mobile.mjs",
    "server": "tsx server/index.ts",
    "server:build": "esbuild server/index.ts scripts/create-staff.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outdir=dist-server --out-extension:.js=.mjs",
    "build:all": "npm run build:app && npm run server:build",
    "start": "node dist-server/server/index.mjs",
    "staff:create": "tsx scripts/create-staff.ts",
    "build:app": "VITE_ORDER_API=/api npm run build",
    "e2e": "node scripts/e2e-server.mjs",
    "test:server": "vitest run server",
    "dev:full": "VITE_ORDER_API=/api vite --host"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@hono/node-server": "^2.1.4",
    "hono": "^4.13.13",
    "i18next": "^26.4.2",
    "nodemailer": "^10.0.16",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
