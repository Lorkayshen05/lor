# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://bekusegar:bekusegar_dev@localhost:5432/bekusegar_dev"

# --- Auth ---
# Generate with: openssl rand -base64 48   (min 32 chars; required in production)
AUTH_SECRET="dev-only-secret-change-me-dev-only-secret-change-me"

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Seed: first admin account (required in production; dev falls back to defaults) ---
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-admin-password"

# --- Optional integrations ---
# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX (script only loads when set)
NEXT_PUBLIC_GA_ID=""
# Google Maps Embed API key (browser key, restrict by HTTP referrer). Falls back to keyless embed if unset.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=""
# Google Search Console HTML-tag verification token
NEXT_PUBLIC_GSC_VERIFICATION=""

# --- Uploads ---  ("local" = ./storage on disk, dev/VPS only; "none" disables photo uploads)
STORAGE_DRIVER="local"
