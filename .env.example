# Supabase project settings (Project Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key — server-only, NEVER prefix with NEXT_PUBLIC_ or expose to
# the client. Used only by the checkout server action to save orders on
# behalf of anonymous customers, and to read order confirmations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL, used for metadata/OG/sitemap absolute URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
