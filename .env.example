# Copy to .env (never commit .env). Every value is optional unless marked REQUIRED.
# Real environment variables always win over this file.

NODE_ENV=development
PORT=8787
# Where the SQLite database lives. Put it on a persistent, backed-up disk.
DATABASE_PATH=./data/ruby.db
BUSINESS_TZ=Asia/Kuala_Lumpur

# REQUIRED in production (min 32 chars). Signs customer order-tracking tokens. Generate: openssl rand -hex 32
ORDER_TOKEN_SECRET=
# Production refuses to take orders while the placeholder sample menu is loaded. Leave false for real use.
ALLOW_SAMPLE_MENU=false
# Set true only when running behind a reverse proxy you control (trusts X-Forwarded-For for rate limiting).
TRUST_PROXY=false

# Customer name/phone are erased this many days after the order.
CONTACT_RETENTION_DAYS=30
SESSION_HOURS=12

# --- Staff notifications (each channel is used only when ALL of its settings are present) ---
# Email (any SMTP provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
STAFF_EMAIL_TO=

# WhatsApp Business Cloud API (Meta). Needs an approved message template with 3 body parameters.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_STAFF_TO=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
# Pin the Graph API version you have verified against Meta's current docs.
WHATSAPP_API_VERSION=

# Kitchen display / any system that accepts a signed webhook
KDS_WEBHOOK_URL=
KDS_WEBHOOK_SECRET=

# --- Ruby Dessert Guide AI (optional; the guide works from menu rules without it) ---
ANTHROPIC_API_KEY=
# Default is claude-opus-5-5. A smaller/cheaper model can be set here.
AI_MODEL=
AI_TIMEOUT_MS=20000
AI_ENABLED=true

# --- Scheduled reports ---
REPORT_HOUR=8
REPORT_DAILY_EMAIL=false

WORKER_INTERVAL_MS=15000
NOTIFY_MAX_ATTEMPTS=5
