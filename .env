# Local SQLite via libsql. Point DATABASE_URL at a Turso database (libsql://...)
# and set DATABASE_AUTH_TOKEN in production.
DATABASE_URL="file:./local.db"
DATABASE_AUTH_TOKEN=""

# Optional: enables live AI Tutor replies via the Anthropic API. Without it,
# the AI Tutor falls back to rule-based responses for every mode.
ANTHROPIC_API_KEY=""

# Optional: a Piston (https://github.com/engineer-man/piston) instance URL for
# trusted server-side re-execution of CODE quest submissions. Without it,
# submissions are accepted from the browser's Pyodide result (verified="client").
PISTON_URL=""

APP_TIMEZONE="Asia/Kuala_Lumpur"

# Session cookie signing/verification uses a plain SHA-256 of the random
# token itself (no secret needed), so no SESSION_SECRET is required.
