// PlayGame — learning game platform for AI/Python
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  BOSS
}

enum SubmissionStatus {
  PASSED
  FAILED
  ERROR
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

enum TestKind {
  STDOUT
  EXPRESSION
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  role         Role     @default(USER)
  xp           Int      @default(0)
  level        Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile      Profile?
  streak       Streak?
  submissions  Submission[]
  progress     Progress[]
  achievements UserAchievement[]
  mistakes     Mistake[]
  projects     Project[]

  @@index([xp])
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String
  bio         String?
  avatarUrl   String?
  goal        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Streak {
  id         String    @id @default(cuid())
  userId     String    @unique
  current    Int       @default(0)
  longest    Int       @default(0)
  lastActive DateTime?
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  icon        String   @default("🎯")
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules Module[]

  @@index([order])
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  slug        String
  title       String
  description String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([courseId, slug])
  @@index([courseId, order])
}

model Lesson {
  id        String   @id @default(cuid())
  moduleId  String
  slug      String
  title     String
  summary   String
  content   String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  module Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  quests Quest[]

  @@unique([moduleId, slug])
  @@index([moduleId, order])
}

model Quest {
  id               String     @id @default(cuid())
  lessonId         String
  slug             String
  title            String
  description      String
  difficulty       Difficulty @default(EASY)
  concept          String
  instructions     String
  starterCode      String
  expectedBehavior String
  hints            String[]
  solution         String
  xp               Int        @default(10)
  order            Int        @default(0)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  lesson      Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  testCases   TestCase[]
  submissions Submission[]
  progress    Progress[]
  mistakes    Mistake[]

  @@unique([lessonId, slug])
  @@index([lessonId, order])
  @@index([difficulty])
}

model TestCase {
  id         String   @id @default(cuid())
  questId    String
  name       String
  kind       TestKind @default(STDOUT)
  expression String?
  expected   String
  hidden     Boolean  @default(false)
  order      Int      @default(0)

  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@index([questId, order])
}

model Submission {
  id          String           @id @default(cuid())
  userId      String
  questId     String
  code        String
  status      SubmissionStatus
  stdout      String           @default("")
  stderr      String           @default("")
  passedCount Int              @default(0)
  totalCount  Int              @default(0)
  durationMs  Int              @default(0)
  xpAwarded   Int              @default(0)
  verified    Boolean          @default(false)
  createdAt   DateTime         @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([questId, createdAt])
}

model Progress {
  id          String         @id @default(cuid())
  userId      String
  questId     String
  status      ProgressStatus @default(NOT_STARTED)
  attempts    Int            @default(0)
  hintsUsed   Int            @default(0)
  mastery     Float          @default(0)
  xpEarned    Int            @default(0)
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, questId])
  @@index([userId, status])
}

model Achievement {
  id          String   @id @default(cuid())
  code        String   @unique
  title       String
  description String
  icon        String   @default("🏆")
  xpReward    Int      @default(0)
  createdAt   DateTime @default(now())

  users UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

model Mistake {
  id         String   @id @default(cuid())
  userId     String
  questId    String
  error      String
  concept    String
  correction String
  retryCount Int      @default(1)
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, questId, concept])
  @@index([userId, resolved])
}

model Project {
  id          String        @id @default(cuid())
  userId      String
  title       String
  description String
  technology  String[]
  status      ProjectStatus @default(PLANNED)
  githubUrl   String?
  demoUrl     String?
  completion  Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}
